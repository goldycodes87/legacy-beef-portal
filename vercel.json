{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://legacylandandcattleco.com"
  },
  "crons": [
    {
      "path": "/api/cron/reminder-10day",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/reminder-1day",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/auto-lock",
      "schedule": "0 14 * * *"
    }
  ]
}
